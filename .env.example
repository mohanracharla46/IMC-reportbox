# Work Report Management System - Email Configuration Template
# Rename or copy this file to .env and fill in your actual SMTP mail server credentials.

# SMTP Mail Server (Use iramediaconcepts.com or your mail host)
MAIL_SERVER=iramediaconcepts.com

# SMTP Port (465 for SSL, 587 for TLS)
MAIL_PORT=465

# SMTP Username (your email address)
MAIL_USERNAME=prashanth@iramediaconcepts.com

# SMTP Password
MAIL_PASSWORD=your-email-password-here

# Security flags
MAIL_USE_TLS=false
MAIL_USE_SSL=true

# Admin Email (Recipient for new leave application notifications)
ADMIN_EMAIL=prashanth@iramediaconcepts.com
